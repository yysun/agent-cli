{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": false,
    "strict": false,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "cli/src/**/*.ts",
    "core/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
