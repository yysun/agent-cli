# Runtime defaults
LLM_PROVIDER=openai
LLM_MODEL=gpt-5
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_TOOL_PERMISSION=
LLM_REASONING_EFFORT=
LLM_PAST_MESSAGES=
LLM_STREAM_TRACE=
LLM_WEB_SEARCH=

# Provider credentials (set based on LLM_PROVIDER)
